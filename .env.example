# CortexAi Environment Variables Example
# Copy this file to .env and update with your actual API keys

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenRouter API Key
OPENROUTER_API_KEY=sk-your-openrouter-api-key-here

# Anthropic API Key (if needed)
# ANTHROPIC_API_KEY=sk-your-anthropic-api-key-here

# Other configuration variables
# DEBUG=false
# LOG_LEVEL=INFO
